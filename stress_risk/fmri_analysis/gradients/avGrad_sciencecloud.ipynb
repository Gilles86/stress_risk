    "from brainspace.gradient import GradientMaps\n",
    "\n",
    "gm = GradientMaps(n_components=3, random_state=0) \n",
    "# Kernel function. If None, only sparsify. Default is None.\n",
    "# Embedding approach. Default is 'dm'\n",
    "gm.fit(av_cm_transf)\n",
    "\n",
    "file_name = f'gm_av{len(subList)}_unfiltered.npy'\n",
    "np.save(op.join(target_folder,file_name),gm.gradients_)\n",
    "print(f'saved to: {op.join(target_folder,file_name)}')"
   ]
  },
