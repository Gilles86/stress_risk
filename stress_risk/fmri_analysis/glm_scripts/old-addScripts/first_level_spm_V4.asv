function first_level_spm_V4(subject,session,bids_folder, model)
   % differentiates between trials where v2 or v1 was chosen
   % models at 4 different timepoints (for 2 different trials) 
   % v1 always at v1-stimulus presentationm --> v1_ch, v1_unch
   % v2 --> v2_ch, v2_unch 

   % difference is now just generated from contrast vectors, not as beta
   % from pmod

   % corrected error for contrast naimng (v1_unch and v2_ch swapped)
   
   
   if model == 'EV' % to lazy to rename files 
       naming_err = '';
   else
       naming_err = '_';
   end
   
   model_name = ['1stlevel_' model '-3b']
   target_folder= strcat(bids_folder,'/derivatives','/spm/',subject,'/',session);
   cd(target_folder)  
   clear matlabbatch

    matlabbatch{1}.cfg_basicio.file_dir.dir_ops.cfg_mkdir.parent = cellstr(target_folder);
    matlabbatch{1}.cfg_basicio.file_dir.dir_ops.cfg_mkdir.name = model_name;
    %--------------------------------------------------------------------------
    matlabbatch{2}.spm.stats.fmri_spec.dir = cellstr(fullfile(target_folder,model_name));
    matlabbatch{2}.spm.stats.fmri_spec.timing.units = 'secs';


   for run= 1:6
    %data_json = jsondecode(fileread(fullfile(bids_folder,  subject, session, 'func',[subject '_' session '_task-risk_run-' num2str(run) '_bold.json'])))
    TR = 2.2980 ; %data_json.RepetitionTime;
    Nslices =  39; %numel(data_json.SliceTiming);
    refSlice = 20; %round(Nslices/2); % 

    matlabbatch{2}.spm.stats.fmri_spec.timing.RT = TR;        % interscan interval
    matlabbatch{2}.spm.stats.fmri_spec.timing.fmri_t = Nslices;
    matlabbatch{2}.spm.stats.fmri_spec.timing.fmri_t0 = refSlice;

    % 1st Model Specification
    ff = dir(strcat(target_folder,'/fwhm-8_sub*run-', string(run), '*.nii'));
    ff = spm_select('ExtList',target_folder,ff.name ,Inf);  
    
    file_nuisance = fullfile(bids_folder,'derivatives','spm', subject, session,[subject '_' session '_task-risk_run-' num2str(run) '_mult-reg-confounds.mat']);

    risky_first = load(strcat(target_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_risky-first' model '-4.txt']));
    risky_second = load(strcat(target_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_risky-second' model '-4.txt']));
    safe_first = load(strcat(target_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_safe-first' model '-4.txt']));
    safe_second = load(strcat(target_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_safe-second' model '-4.txt']));
   
    matlabbatch{2}.spm.stats.fmri_spec.sess(run).scans = cellstr(spm_file(ff));

            % risky_first
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).name = 'risky_first';
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).onset = risky_first(:,1);    % vetor like data
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).duration = 0.6;
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).pmod.name = 'risky_first_value';
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).pmod.param = risky_first(:,2);
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).pmod.poly = 1;
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(1).orth = 0;
            
            % risky_second
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).name = 'risky_second';
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).onset = risky_second(:,1);    % vetor like data
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).duration = 0.6;
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).pmod.name = 'risky_second_value';
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).pmod.param = risky_second(:,2);
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).pmod.poly = 1;
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(2).orth = 0;
            
            % safe_first
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).name = 'safe_first';
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).onset = safe_first(:,1);    % vetor like data
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).duration = 0.6;
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).pmod.name = 'safe_first_value';
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).pmod.param = safe_first(:,2);
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).pmod.poly = 1;
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(3).orth = 0;
            
            % v2_unchosen
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).name = 'safe_second';
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).onset = safe_second(:,1);    % vetor like data
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).duration = 0.6;
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).pmod.name = 'safe_second_value';
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).pmod.param = safe_second(:,2);
                matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).pmod.poly = 1;
            matlabbatch{2}.spm.stats.fmri_spec.sess(run).cond(4).orth = 0;

        matlabbatch{2}.spm.stats.fmri_spec.sess(run).multi_reg   = cellstr(file_nuisance);
   
   end % of run loop

    matlabbatch{3}.spm.stats.fmri_est.spmmat = cellstr(fullfile(target_folder,model_name,'SPM.mat'));
    
    % automatically generate the contrast vectors dependant on the number
    % of regressors, dependant on the number of confounds from the multReg
    load(file_nuisance);
    n_cond_reg = 8; % 2*2 + 2*2 = (risky/safe * first/second) * (event, pmod1)
    n_conf = size(R,2);
    n_reg = (n_cond_reg + n_conf) * 6 + 6
    y = zeros(1, n_reg); n1 = y; n2 = y; n3 = y; n4 = y; n5 = y; n6=y;
    x1 = 2:n_cond_reg + n_conf:n_reg-6; % risky_first
    x2 = 4:n_cond_reg + n_conf:n_reg-6; % risky_second
    x3 = 6:n_cond_reg + n_conf:n_reg-6; % safe_first
    x4 = 8:n_cond_reg + n_conf:n_reg-6; % safe_second

    n1(x1)=1; 
    n2(x2)=1; 
    n3(x3)=1; 
    n4(x4)= 1;
    n5(x1)=1; n5(x4)= -1;% 
    n6(x3) = 1; n6(x2) = -1;% 

    matlabbatch{4}.spm.stats.con.spmmat = cellstr(fullfile(target_folder,model_name,'SPM.mat'));
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.name = 'risky_first';
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.weights = n1;
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.name = 'risky_second';
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.weights = n2;
    matlabbatch{4}.spm.stats.con.consess{3}.tcon.name = 'safe_first';
    matlabbatch{4}.spm.stats.con.consess{3}.tcon.weights = n3;
    matlabbatch{4}.spm.stats.con.consess{4}.tcon.name = 'safe_second';
    matlabbatch{4}.spm.stats.con.consess{4}.tcon.weights = n4;
    matlabbatch{4}.spm.stats.con.consess{5}.tcon.name = 'v1_ch_dif';
    matlabbatch{4}.spm.stats.con.consess{5}.tcon.weights = n5;
    matlabbatch{4}.spm.stats.con.consess{6}.tcon.name = 'v2_ch_dif';
    matlabbatch{4}.spm.stats.con.consess{6}.tcon.weights = n6;
    
    spm_jobman('run',matlabbatch);
end