function first_level_spm_V4_bothSessions(subject,bids_folder, model)
   % differentiates between risky/safe first/second
    
   model_name = ['1stlevel_' model '-4'];
   target_folder= strcat(bids_folder,'/derivatives','/spm/',subject);
   cd(target_folder)  
   clear matlabbatch

    matlabbatch{1}.cfg_basicio.file_dir.dir_ops.cfg_mkdir.parent = cellstr(target_folder);
    matlabbatch{1}.cfg_basicio.file_dir.dir_ops.cfg_mkdir.name = model_name;
    %--------------------------------------------------------------------------
    matlabbatch{2}.spm.stats.fmri_spec.dir = cellstr(fullfile(target_folder,model_name));
    matlabbatch{2}.spm.stats.fmri_spec.timing.units = 'secs';
    
   sesList={'ses-1','ses-2'};
   for ses=1:2
       session = sesList{ses};
       source_folder= strcat(bids_folder,'/derivatives','/spm/',subject,'/',session);

       for run= 1:6
        %data_json = jsondecode(fileread(fullfile(bids_folder,  subject, session, 'func',[subject '_' session '_task-risk_run-' num2str(run) '_bold.json'])))
        TR = 2.2980 ; %data_json.RepetitionTime;
        Nslices =  39; %numel(data_json.SliceTiming);
        refSlice = 20; %round(Nslices/2); % 
    
        matlabbatch{2}.spm.stats.fmri_spec.timing.RT = TR;        % interscan interval
        matlabbatch{2}.spm.stats.fmri_spec.timing.fmri_t = Nslices;
        matlabbatch{2}.spm.stats.fmri_spec.timing.fmri_t0 = refSlice;
    
        % 1st Model Specification
        ff = dir(strcat(target_folder,'/fwhm-8_sub*',session,'*run-', string(run), '*.nii'));
        ff = spm_select('ExtList',target_folder,ff.name ,Inf);  % needs all the .nii files to be in the same parent folder
        
        file_nuisance = fullfile(bids_folder,'derivatives','spm', subject, session,[subject '_' session '_task-risk_run-' num2str(run) '_mult-reg-confounds.mat']);
    
        risky_first = load(strcat(source_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_risky-first_' model '-4.txt']));
        risky_second = load(strcat(source_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_risky-second_' model '-4.txt']));
        safe_first = load(strcat(source_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_safe-first_' model '-4.txt']));
        safe_second = load(strcat(source_folder,'/event_files/',subject,'_',session,'_task-risk_run-',num2str(run),['_events_safe-second_' model '-4.txt']));
       

        n_sess = (ses-1)*6 + run;

        matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).scans = cellstr(spm_file(ff));
    
                % risky_first
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).name = 'risky_first';
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).onset = risky_first(:,1);    % vetor like data
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).duration = 0.6;
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).pmod.name = 'risky_first_value';
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).pmod.param = risky_first(:,2);
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).pmod.poly = 1;
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(1).orth = 0;
                
                % risky_second
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).name = 'risky_second';
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).onset = risky_second(:,1);    % vetor like data
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).duration = 0.6;
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).pmod.name = 'risky_second_value';
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).pmod.param = risky_second(:,2);
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).pmod.poly = 1;
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(2).orth = 0;
                
                % safe_first
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).name = 'safe_first';
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).onset = safe_first(:,1);    % vetor like data
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).duration = 0.6;
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).pmod.name = 'safe_first_value';
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).pmod.param = safe_first(:,2);
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).pmod.poly = 1;
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(3).orth = 0;
                
                % v2_unchosen
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).name = 'safe_second';
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).onset = safe_second(:,1);    % vetor like data
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).duration = 0.6;
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).pmod.name = 'safe_second_value';
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).pmod.param = safe_second(:,2);
                    matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).pmod.poly = 1;
                matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).cond(4).orth = 0;
    
            matlabbatch{2}.spm.stats.fmri_spec.sess(n_sess).multi_reg   = cellstr(file_nuisance);
       
       end % of run loop
    
   end
    matlabbatch{3}.spm.stats.fmri_est.spmmat = cellstr(fullfile(target_folder,model_name,'SPM.mat'));
    
    % automatically generate the contrast vectors dependant on the number
    % of regressors, dependant on the number of confounds from the multReg
    load(file_nuisance);
    n_cond_reg = 16; %  2 * 2*2 + 2*2 = (sessions * risky/safe * first/second) * (event, pmod1)
    n_conf = size(R,2);
    n_reg = (n_cond_reg + n_conf) * 6 + 6
    y = zeros(1, n_reg); rfe = y; rfp = y; rse = y; rsp = y;sfe = y; sfp = y; sse = y; ssp = y;
    
    %session 1
    x1 = 1:n_cond_reg + n_conf:n_reg-6; % risky_first event
    x2 = 2:n_cond_reg + n_conf:n_reg-6; % risky_first pmod
    x3 = 3:n_cond_reg + n_conf:n_reg-6; % risky_second event
    x4 = 4:n_cond_reg + n_conf:n_reg-6; % risky_second pmod
    x5 = 5:n_cond_reg + n_conf:n_reg-6; % safe_first event
    x6 = 6:n_cond_reg + n_conf:n_reg-6; % safe_first pmod
    x7 = 7:n_cond_reg + n_conf:n_reg-6; % safe_second event
    x8 = 8:n_cond_reg + n_conf:n_reg-6; % safe_second pmod


    %session 1
    x9 = 9:n_cond_reg + n_conf:n_reg-6; % risky_first event
    x10 = 10:n_cond_reg + n_conf:n_reg-6; % risky_first pmod
    x11 = 11:n_cond_reg + n_conf:n_reg-6; % risky_second event
    x12 = 12:n_cond_reg + n_conf:n_reg-6; % risky_second pmod
    x13 = 13:n_cond_reg + n_conf:n_reg-6; % safe_first event
    x14 = 14:n_cond_reg + n_conf:n_reg-6; % safe_first pmod
    x15 = 15:n_cond_reg + n_conf:n_reg-6; % safe_first
    x16 = 16:n_cond_reg + n_conf:n_reg-6; % safe_second

    rfe(x1) = -1; rfe(x9)=1;
    rfp(x2) = -1; rfp(x10)=1;
    rse(x3) = -1; rse(x11)=1;
    rsp(x4) = -1; rsp(x12)=1;
    sfe(x5) = -1; sfe(x13)=1;
    sfp(x6) = -1; sfp(x14)=1;
    sse(x7) = -1; sse(x15)=1;
    ssp(x8) = -1; ssp(x16)=1;

    matlabbatch{4}.spm.stats.con.spmmat = cellstr(fullfile(target_folder,model_name,'SPM.mat'));
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.name = 'risky_first_event_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.weights = rfe;
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.name = 'risky_first_pmod_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.weights = rfp;
    matlabbatch{4}.spm.stats.con.consess{3}.tcon.name = 'risky_second_event_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{3}.tcon.weights = rse;
    matlabbatch{4}.spm.stats.con.consess{4}.tcon.name = 'risky_second_pmod_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{4}.tcon.weights = rsp;
    matlabbatch{4}.spm.stats.con.consess{5}.tcon.name = 'safe_first_event_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{5}.tcon.weights = sfe;
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.name = 'safe_first_pmod_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.weights = sfp;
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.name = 'safe_second_event_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{1}.tcon.weights = sse;
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.name = 'safe_second_pmod_ses2-ses1';
    matlabbatch{4}.spm.stats.con.consess{2}.tcon.weights = ssp;

    spm_jobman('run',matlabbatch);
end